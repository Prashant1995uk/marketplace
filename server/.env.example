PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/notes_marketplace
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI (summarization)
OPENAI_API_KEY=

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Public base URL for locally stored files (no trailing slash)
PUBLIC_BASE_URL=http://localhost:5000

# Commission on paid notes (decimal, e.g. 0.2 = 20%)
COMMISSION_RATE=0.2

# Free tier daily download limit
FREE_DAILY_DOWNLOAD_LIMIT=5
